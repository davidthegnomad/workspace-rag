# Workspace RAG — environment variables
# Copy this file to .env at the repo root and fill in your values:
#   cp .env.example .env
#
# Never commit .env or service account JSON files.

# =============================================================================
# OPTIONAL — Firebase, only when external config says store: firestore
# The default index is a local SQLite file. You can leave these blank.
# =============================================================================

# Your Firebase / GCP project ID (Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service account JSON path
# Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# =============================================================================
# INTERNAL (Gnomad ORGANIZATION index)
# =============================================================================

# Firestore collection for internal swarm index (default shown)
FIRESTORE_COLLECTION=workspace_rag_internal

# ORGANIZATION workspace root — auto-detected on Mac/SteamDrive if omitted
# WORKSPACE_ROOT=/Users/you/Desktop/AI Project Folder/ORGANIZATION

# =============================================================================
# EXTERNAL (distributable product — optional, uses external/config.yaml too)
# =============================================================================

# Uncomment if running external/cli.py against a different collection:
# FIRESTORE_COLLECTION=workspace_rag_external

# =============================================================================
# OPTIONAL — Ollama (local embeddings)
# =============================================================================

# Default: http://localhost:11434
# Requires: ollama pull nomic-embed-text
# OLLAMA_HOST=http://localhost:11434
