# =============================================================================
# Secrets — never commit
# =============================================================================

.env
.env.*
!.env.example
internal/.env
internal/.env.*
external/.env
external/.env.*

# Firebase / GCP service account keys (any filename shape)
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
serviceAccount*.json
**/serviceAccount*.json
*-firebase-adminsdk-*.json
firebase-service-account.json
google-credentials.json
*.credentials.json

# Local credential directories
credentials/
keys/
secrets/
**/credentials/
**/keys/

# Certs / keys
*.pem
*.p12
*.key

# =============================================================================
# Python
# =============================================================================

.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# External user config (keep example)
external/config.yaml

# =============================================================================
# OS / IDE
# =============================================================================

.DS_Store
.idea/
.vscode/

# Local run logs
.agents/LOGS/index-run.log
.agents/LOGS/index-run.pid
